[mysqld]
# --- Memory tuning for 1 GB instance (action item #4) ---
innodb_buffer_pool_size=256M
max_connections=50
performance_schema=OFF

# --- Query timeout (action item #2) ---
# Kills SELECT statements that exceed 30 seconds of execution time.
# Does not affect INSERT/UPDATE/DELETE.
max_execution_time=30000

# --- Reduce fsync overhead on small-IO instances ---
# Trade: up to 1 second of writes may be lost on OS crash.
# Acceptable for this workload; durability still guaranteed at per-second granularity.
innodb_flush_log_at_trx_commit=2
